# Copy to .env.local for local development.
#
# Usually you do NOT need this. With `npm run dev` the app defaults to a local FastAPI on
# http://localhost:8001, and on Vercel it uses the same origin it was served from
# (/api/*, rewritten to the backend service) so no configuration is required there.
#
# Set it when the API is somewhere else, or when running a *production* build locally
# (`npm run build && npm start`), where the bundle would otherwise use the deployed
# same-origin path.
#
# Read in the browser, so it must be NEXT_PUBLIC_. Never put a secret here — anything
# NEXT_PUBLIC_ is compiled into the client bundle and is public.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
