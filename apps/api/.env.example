# Copy to .env for local development. Never put a real key or password in this file —
# .env.example is committed; .env is gitignored.

# Investigation calls OpenAI; everything else in IncidentIQ runs without it.
OPENAI_API_KEY=

# Durable operational state: investigation runs, actions, approvals, executions, audit
# events, and the historical corpus with its vectors. Matches docker-compose.yml, which
# publishes on 5434 to avoid colliding with an existing local PostgreSQL.
# The credentials below are the compose file's local development values, not secrets.
DATABASE_URL=postgresql+psycopg://incidentiq:incidentiq@localhost:5434/incidentiq

# Optional overrides:
# INCIDENTIQ_INVESTIGATION_MODEL=gpt-5.6-terra
